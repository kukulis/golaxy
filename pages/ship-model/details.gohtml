{{define "ship_model_details"}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galaktika - Ship Model</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="icon" type="image/x-icon" href="/assets/img/Goodstuff-No-Nonsense-Free-Space-Galaxy.ico">
    <style>
        #container { width: 100%; max-width: 500px; }
    </style>
</head>
<body>
<div id="game-container">
    <div id="user-menu" data-ship-model="{{.Id}}"></div>
    <h1 id="page-title"></h1>
    <p id="error-msg" style="display:none"></p>
    <div id="container">
        <!-- generated with JS -->
    </div>
</div>
<script type="module">
    import {ClearE, GetE} from '/assets/js/helper.js';
    import {App} from '/assets/js/app.js';

    const id = '{{.Id}}';
    document.getElementById('page-title').textContent = `Ship Model: ${id}`;

    const app = new App();
    app.renderMenu();

    ClearE(GetE('container')).appendChild(await app.getShipModelComponent().renderDetails(id));
</script>
</body>
</html>
{{end}}
