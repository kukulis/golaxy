{{define "ship_model_assignment"}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galaktika - Ship Model Assignment</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="icon" type="image/x-icon" href="/assets/img/Goodstuff-No-Nonsense-Free-Space-Galaxy.ico">
</head>
<body>
<div id="game-container">
    <div id="user-menu" data-division-id="{{.DivisionId}}" data-fleet-build="{{.FleetBuildId}}"></div>
    <h1 id="page-title">Ship Model Assignment</h1>
    <p id="error-msg" style="display:none"></p>
    <div id="assignment-container">
        <!-- generated with JS -->
    </div>
</div>
<script type="module">
    import {ClearE, GetE} from '/assets/js/helper.js';
    import {App} from '/assets/js/app.js';
    import {ShipModelAssignmentView} from '/assets/js/ship_model_assignment_view.js';

    const assignmentId = '{{.ShipModelAssignmentId}}';
    const fleetBuildId = '{{.FleetBuildId}}';
    const divisionId = '{{.DivisionId}}';

    const app = new App();
    app.renderMenu();

    const view = new ShipModelAssignmentView(app.getApiClient(), app.getDispatcher());
    view.setAssignmentId(assignmentId);
    view.setFleetBuildId(fleetBuildId);
    view.setDivisionId(divisionId);

    const el = await view.generateView();
    ClearE(GetE('assignment-container')).appendChild(el);
</script>
</body>
</html>
{{end}}
