{{define "fleet_build_main"}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Galaktika - Fleet Build</title>
    <link rel="stylesheet" href="/assets/css/style.css">
    <link rel="icon" type="image/x-icon" href="/assets/img/Goodstuff-No-Nonsense-Free-Space-Galaxy.ico">
    <style>
        #fleet-build-container { width: 100%; max-width: 1100px; }
    </style>
</head>
<body>
<div id="game-container">
    <div id="user-menu" data-division-id="{{.DivisionId}}" data-fleet-build="{{.Id}}"></div>
    <h1 id="page-title"></h1>
    <p id="error-msg" style="display:none"></p>
    <div id="fleet-build-container">
        <!-- generated with JS -->
    </div>
</div>
<script type="module">
    import {ClearE, GetE} from '/assets/js/helper.js';
    import {App} from '/assets/js/app.js';

    const buildId = '{{.Id}}';
    const divisionId = '{{.DivisionId}}';
    document.getElementById('page-title').textContent = `Fleet Build: ${buildId}`;

    const app = new App();
    app.renderMenu();

    const fleetBuildView = app.getFleetBuildView();
    fleetBuildView.setBuildId(buildId);
    fleetBuildView.setDivisionId(divisionId);
    const view = await fleetBuildView.generateView();
    ClearE(GetE('fleet-build-container')).appendChild(view);
</script>
</body>
</html>
{{end}}
